# ---------------------------------------------------------------------------
# Environment configuration template
#
# Copy this file to .env and fill in only what you need:
#
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (bash)
#
# .env is gitignored. Never commit real credentials.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Optional: external IP reputation lookup
#
# The detection pipeline does NOT require these. Leave them blank to run the
# system fully offline — scoring then uses the built-in header + flow heuristic
# documented in README section 8.5.
#
# The heuristic is also used automatically whenever a lookup cannot apply:
# the credentials are missing, the address is private / loopback / reserved,
# or the request fails.
#
# WARNING: set either ALL THREE of BASE_URL, USER and KEY, or none of them.
# If USER and KEY are set while BASE_URL is empty, the request URL is built as
# the literal "None/<user>/?..." and the error is raised before the retry
# guard in fyp1.py, which aborts the whole scoring stage instead of falling
# back to the heuristic.
# ---------------------------------------------------------------------------

SCAMALYTICS_BASE_URL=
SCAMALYTICS_USER=
SCAMALYTICS_KEY=

# Lookup timeout in seconds. Default when unset: 3.0
SCAMALYTICS_TIMEOUT=3.0
